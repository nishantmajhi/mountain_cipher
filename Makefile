# Build the Mountain Cipher tools and tests.
#
#   make            - build mountain_encrypt and mountain_decrypt
#   make test       - build and run every test
#   make clean      - remove build output
#
# Needs OpenSSL (libcrypto, for SHA-256 and SHAKE-256) and libargon2.
# Where those are not on the default search path - which is every Windows
# machine - append to the search paths rather than replacing the flags:
#
#   make EXTRA_CFLAGS=-IC:/path/to/argon2/include \
#        EXTRA_LDFLAGS=-LC:/path/to/argon2/lib \
#        EXTRA_LDLIBS="-lws2_32 -lcrypt32 -ladvapi32 -luser32"
#
# The extra libraries on that last line are what a static OpenSSL needs on
# Windows; they are harmless to omit elsewhere. See README "Building".

CC      = gcc
EXTRA_CFLAGS  ?=
EXTRA_LDFLAGS ?=
EXTRA_LDLIBS  ?=
CFLAGS  = -std=c11 -Wall -Wextra -O2 -Iinclude $(EXTRA_CFLAGS)
LDFLAGS = $(EXTRA_LDFLAGS)
LDLIBS  = -lcrypto -largon2 $(EXTRA_LDLIBS)

SRC_DIR       = src
OBJ_DIR       = build
TEST_UNIT_DIR = tests/unit
TEST_INT_DIR  = tests/integration

CORE_OBJS = $(OBJ_DIR)/mountain_cipher.o $(OBJ_DIR)/cli_util.o

.PHONY: all clean test test-unit test-integration

all: mountain_encrypt mountain_decrypt

$(OBJ_DIR):
	mkdir -p $(OBJ_DIR)

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c include/mountain_cipher.h include/cli_util.h | $(OBJ_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

mountain_encrypt: $(OBJ_DIR)/mountain_encrypt.o $(CORE_OBJS)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)

mountain_decrypt: $(OBJ_DIR)/mountain_decrypt.o $(CORE_OBJS)
	$(CC) $(CFLAGS) $^ -o $@ $(LDFLAGS) $(LDLIBS)

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Unit tests link directly against the core implementation object file -
# they exercise the C API (matrix math, hashing, key derivation), not the
# CLI binaries.
$(OBJ_DIR)/test_matrix: $(TEST_UNIT_DIR)/test_matrix.c $(OBJ_DIR)/mountain_cipher.o include/mountain_cipher.h $(TEST_UNIT_DIR)/test_framework.h | $(OBJ_DIR)
	$(CC) $(CFLAGS) -I$(TEST_UNIT_DIR) $(TEST_UNIT_DIR)/test_matrix.c $(OBJ_DIR)/mountain_cipher.o -o $@ $(LDFLAGS) $(LDLIBS)

$(OBJ_DIR)/test_crypto: $(TEST_UNIT_DIR)/test_crypto.c $(OBJ_DIR)/mountain_cipher.o include/mountain_cipher.h $(TEST_UNIT_DIR)/test_framework.h | $(OBJ_DIR)
	$(CC) $(CFLAGS) -I$(TEST_UNIT_DIR) $(TEST_UNIT_DIR)/test_crypto.c $(OBJ_DIR)/mountain_cipher.o -o $@ $(LDFLAGS) $(LDLIBS)

# test_cipher drives the block pipeline against vectors.h, which is
# generated by tools/gen_vectors.py from the specification - see the top of
# that script. The generated header is committed; regenerating it needs
# Python but running the tests does not.
$(OBJ_DIR)/test_cipher: $(TEST_UNIT_DIR)/test_cipher.c $(OBJ_DIR)/mountain_cipher.o include/mountain_cipher.h $(TEST_UNIT_DIR)/test_framework.h $(TEST_UNIT_DIR)/vectors.h | $(OBJ_DIR)
	$(CC) $(CFLAGS) -I$(TEST_UNIT_DIR) $(TEST_UNIT_DIR)/test_cipher.c $(OBJ_DIR)/mountain_cipher.o -o $@ $(LDFLAGS) $(LDLIBS)

$(OBJ_DIR)/test_cli_util: $(TEST_UNIT_DIR)/test_cli_util.c $(OBJ_DIR)/mountain_cipher.o $(OBJ_DIR)/cli_util.o include/cli_util.h $(TEST_UNIT_DIR)/test_framework.h | $(OBJ_DIR)
	$(CC) $(CFLAGS) -I$(TEST_UNIT_DIR) $(TEST_UNIT_DIR)/test_cli_util.c $(OBJ_DIR)/cli_util.o $(OBJ_DIR)/mountain_cipher.o -o $@ $(LDFLAGS) $(LDLIBS)

UNIT_TESTS = $(OBJ_DIR)/test_matrix $(OBJ_DIR)/test_crypto $(OBJ_DIR)/test_cipher $(OBJ_DIR)/test_cli_util

test-unit: $(UNIT_TESTS)
	@for t in $(UNIT_TESTS); do \
		echo "=== Running unit tests: $$t ==="; \
		$$t || exit 1; \
		echo ""; \
	done

# Integration tests drive the actual CLI binaries end to end (encrypt,
# decrypt, wrong password, tamper detection, multiple n values, etc).
test-integration: all
	@echo "=== Running integration tests ==="
	@chmod +x $(TEST_INT_DIR)/test_roundtrip.sh
	@$(TEST_INT_DIR)/test_roundtrip.sh ./mountain_encrypt ./mountain_decrypt

test: test-unit test-integration
	@echo ""
	@echo "All test suites completed."

clean:
	rm -rf $(OBJ_DIR) mountain_encrypt mountain_decrypt mountain_encrypt.exe mountain_decrypt.exe
